{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test ../scripts/architecture.test.mjs ../scripts/ai-lab.test.mjs ../scripts/learning-platform.test.mjs ../scripts/learning-store.test.mjs ../scripts/page-transition.test.mjs ../scripts/jump-budget.test.mjs",
    "verify:committed": "node ../scripts/verify_content.mjs && npm test && npm run lint && ./node_modules/.bin/tsc --noEmit -p tsconfig.app.json",
    "check": "npm run export:curriculum && npm run verify:committed && npm run build",
    "predev": "node ../scripts/export-curriculum.mjs",
    "dev": "vite",
    "prebuild": "node ../scripts/export-curriculum.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "export:curriculum": "node ../scripts/export-curriculum.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.56.0",
    "motion": "14.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sass": "^1.105.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
